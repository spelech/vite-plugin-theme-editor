{
  "name": "vite-plugin-theme-editor",
  "version": "1.0.0",
  "description": "Live in-browser CSS variable theme editor with AST-preserving disk sync for Vite",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:client": "node scripts/bundle-client.mjs",
    "build": "node scripts/bundle-client.mjs && tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "theme",
    "css-variables",
    "devtools",
    "theme-editor"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0"
  },
  "dependencies": {
    "diff": "^7.0.0",
    "fast-glob": "^3.3.2",
    "postcss": "^8.4.38"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
